<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ video.titre }} | Grammaire Normative</title>
    {% load static %}
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Plyr CDN -->
    <link rel="stylesheet" href="https://cdn.plyr.io/3.8.4/plyr.css" />
    <script src="https://cdn.plyr.io/3.8.4/plyr.polyfilled.js"></script>
    
    <style>
        body { font-family: 'Inter', sans-serif; }
        .bg-mesh {
            background-color: #f8fafc;
            background-image: radial-gradient(at 0% 0%, rgba(251, 191, 36, 0.1) 0, transparent 50%),
                              radial-gradient(at 100% 100%, rgba(30, 58, 138, 0.05) 0, transparent 50%);
        }
        .glass-panel {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.4);
        }
        /* Plyr custom styling */
        .video-player-container {
            width: 100%;
            border-radius: 1rem;
            overflow: hidden;
            background: #000;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
        }
        .plyr {
            border-radius: 1rem;
            height: 100%;
        }
        .plyr--full-ui {
            border-radius: 1rem;
        }
        .plyr--video {
            background: #000;
        }
        /* Custom Plyr colors */
        .plyr--video .plyr__control--overlaid,
        .plyr--video .plyr__control.plyr__tab-focus,
        .plyr--video .plyr__control:hover,
        .plyr--video .plyr__control[aria-expanded=true] {
            background: rgba(30, 58, 138, 0.9);
        }
        .plyr--video .plyr__controls .plyr__progress__container input[type=range],
        .plyr--video .plyr__controls .plyr__volume input[type=range] {
            color: #1e3a8a;
        }
        .plyr--full-ui input[type=range] {
            color: #1e3a8a;
        }
        /* Animations */
        @keyframes fade-in {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in {
            animation: fade-in 0.6s ease-out;
        }
        .like-btn.liked {
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            color: white;
        }
        .comment-enter {
            animation: fade-in 0.3s ease-out;
        }
    </style>
</head>
<body class="bg-mesh text-slate-900 antialiased">

    <!-- Navigation -->
    <nav class="sticky top-0 z-50 glass-panel shadow-sm border-b border-white/20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center gap-3">
                    <a href="{% url 'dashboard' %}" class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-blue-900 rounded-xl flex items-center justify-center text-white font-black text-xl shadow-lg">G</div>
                        <span class="font-bold text-lg tracking-tight text-blue-900 hidden sm:block">GRAMMAIRE NORMATIVE</span>
                    </a>
                </div>

                <!-- Barre de recherche -->
                <div class="flex-1 max-w-xl mx-4 hidden md:block">
                    <div class="relative">
                        <input type="text" id="searchInput" placeholder="Rechercher une vidéo..." 
                               class="w-full px-4 py-2.5 pl-11 bg-white/80 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-900/20 focus:border-blue-900 transition-all"
                               autocomplete="off">
                        <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                        
                        <!-- Suggestions -->
                        <div id="searchSuggestions" class="absolute top-full left-0 right-0 mt-2 bg-white border border-slate-200 rounded-xl shadow-2xl max-h-[400px] overflow-y-auto hidden z-50">
                            <div id="suggestionsContent" class="divide-y divide-slate-100"></div>
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-4">
                    {% if user_subscription_info %}
                        <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 bg-green-100 text-green-700 text-xs font-bold rounded-full">
                            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Abonné</span>
                        </div>
                        {% if jours_restants is not None %}
                        <div class="hidden lg:flex items-center gap-2 px-3 py-1.5 bg-blue-100 text-blue-700 text-xs font-bold rounded-full">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <span id="streaming-countdown">{{ temps_restant_detail }}</span>
                        </div>
                        {% endif %}
                    {% else %}
                        <span class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-100 text-slate-600 text-xs font-bold rounded-full">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                            Gratuit
                        </span>
                    {% endif %}
                    <a href="{% url 'dashboard' %}" class="text-sm font-semibold text-slate-600 hover:text-blue-900 transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Contenu principal -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <!-- Fil d'ariane -->
        <nav class="flex items-center gap-2 text-sm text-slate-500 mb-6 animate-fade-in">
            <a href="{% url 'dashboard' %}" class="hover:text-blue-900 transition-colors">Dashboard</a>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <a href="{% url 'video' %}" class="hover:text-blue-900 transition-colors">Vidéos</a>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            {% if video.categorie %}
                <a href="{% url 'video' %}?categorie={{ video.categorie.id }}" class="hover:text-blue-900 transition-colors">{{ video.categorie.nom }}</a>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            {% endif %}
            <span class="text-slate-900 font-medium truncate">{{ video.titre }}</span>
        </nav>

        <div class="grid lg:grid-cols-3 gap-8">
            <!-- Section Vidéo (2/3) -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Lecteur vidéo Plyr -->
                <div class="video-player-container animate-fade-in">
                    <video id="mainVideo" playsinline controls preload="metadata" data-poster="{% if video.miniature %}{{ video.miniature.url }}{% endif %}">
                        <source src="{% url 'stream_video_file' video.id %}" type="video/mp4">
                        <p>Votre navigateur ne supporte pas la lecture vidéo.</p>
                    </video>
                </div>

                <!-- Infos vidéo -->
                <div class="glass-panel rounded-2xl p-6 animate-fade-in" style="animation-delay: 0.1s;">
                    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-4">
                        <div class="flex-1">
                            <div class="flex items-center gap-3 mb-3">
                                <h1 class="text-xl sm:text-2xl font-bold text-slate-900">{{ video.titre }}</h1>
                                {% if video.is_free %}
                                    <span class="inline-flex px-2.5 py-1 bg-green-100 text-green-700 text-xs font-bold rounded-full whitespace-nowrap">Gratuit</span>
                                {% else %}
                                    <span class="inline-flex px-2.5 py-1 bg-amber-100 text-amber-700 text-xs font-bold rounded-full whitespace-nowrap">Premium</span>
                                {% endif %}
                            </div>
                            <div class="flex flex-wrap items-center gap-4 text-sm text-slate-500">
                                {% if video.categorie %}
                                    <a href="{% url 'video' %}?categorie={{ video.categorie.id }}" class="flex items-center gap-1.5 hover:text-blue-900 transition-colors group">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                                        </svg>
                                        <span class="font-medium">{{ video.categorie.nom }}</span>
                                        <svg class="w-3 h-3 text-slate-400 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                        </svg>
                                    </a>
                                {% endif %}
                                <span class="flex items-center gap-1.5">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                    {{ video.date_publication|date:"d M Y" }}
                                </span>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="flex items-center gap-2">
                            <button id="likeBtn" onclick="toggleLike()" class="like-btn flex items-center gap-2 px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm font-semibold hover:bg-slate-50 transition-all {% if user_has_liked %}liked{% endif %}">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"/>
                                </svg>
                                <span id="likeCount">{{ video.likes_count|default:0 }}</span>
                            </button>
                            <button onclick="shareVideo()" class="flex items-center gap-2 px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm font-semibold hover:bg-slate-50 transition-all">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
                                </svg>
                                <span class="hidden sm:inline">Partager</span>
                            </button>
                        </div>
                    </div>

                    <!-- Description avec accordéon -->
                    <div class="border-t border-slate-200 pt-4">
                        <button onclick="toggleDescription()" class="flex items-center justify-between w-full text-left hover:bg-slate-50 p-3 rounded-xl transition-colors" id="descriptionToggle">
                            <h3 class="font-bold text-slate-900 flex items-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                </svg>
                                Description
                            </h3>
                            <svg class="w-5 h-5 text-slate-400 transition-transform transform" id="chevronIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>
                        
                        <!-- Résumé de la description (toujours visible) -->
                        <div id="descriptionSummary" class="mt-3">
                            <p class="text-slate-600 text-sm leading-relaxed">
                                {{ video.description|truncatechars:150 }}{% if video.description|length > 150 %}...{% endif %}
                            </p>
                            {% if video.description|length > 150 %}
                            <button onclick="toggleDescription()" class="text-blue-900 font-bold text-sm mt-2 hover:underline flex items-center gap-1">
                                <span id="expandText">Lire la description complète</span>
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                </svg>
                            </button>
                            {% endif %}
                        </div>
                        
                        <!-- Description complète (cachée par défaut) -->
                        <div id="fullDescription" class="mt-3 hidden">
                            <p class="text-slate-600 text-sm leading-relaxed whitespace-pre-line">
                                {{ video.description|linebreaks }}
                            </p>
                            <button onclick="toggleDescription()" class="text-slate-500 font-bold text-sm mt-2 hover:text-blue-900 flex items-center gap-1">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
                                </svg>
                                <span>Réduire</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Commentaires -->
                <div class="glass-panel rounded-2xl p-6 animate-fade-in" style="animation-delay: 0.2s;">
                    <h3 class="text-lg font-bold text-slate-900 mb-6 flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                        </svg>
                        Commentaires <span id="commentCount" class="text-slate-500 font-normal">({{ commentaires.count }})</span>
                    </h3>

                    <!-- Formulaire -->
                    {% if user.is_authenticated %}
                    <form id="commentForm" method="post" class="mb-8">
                        {% csrf_token %}
                        <div class="flex gap-4">
                            <div class="w-10 h-10 bg-gradient-to-br from-blue-900 to-blue-700 rounded-full flex items-center justify-center text-white font-bold flex-shrink-0">
                                {{ user.first_name|default:user.username|slice:":1"|upper }}
                            </div>
                            <div class="flex-1 relative">
                                <textarea id="commentInput" name="contenu" rows="3" 
                                          placeholder="Ajouter un commentaire..." required
                                          class="w-full px-4 py-3 bg-white border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-900/20 focus:border-blue-900 transition-all resize-none"></textarea>
                                <button type="submit" class="absolute bottom-3 right-3 px-4 py-1.5 bg-blue-900 text-white text-xs font-bold rounded-lg hover:bg-blue-800 transition-all">
                                    Envoyer
                                </button>
                            </div>
                        </div>
                    </form>
                    {% else %}
                    <div class="mb-8 p-4 bg-slate-100 rounded-xl text-center">
                        <p class="text-slate-600 text-sm">Connectez-vous pour ajouter un commentaire.</p>
                        <a href="{% url 'connexion' %}" class="inline-block mt-2 text-blue-900 font-bold text-sm hover:underline">Se connecter</a>
                    </div>
                    {% endif %}

                    <!-- Liste des commentaires -->
                    <div id="commentList" class="space-y-6">
                        {% for commentaire in commentaires %}
                        <div class="flex gap-4 animate-fade-in comment-item">
                            <div class="w-10 h-10 bg-gradient-to-br from-amber-400 to-orange-500 rounded-full flex items-center justify-center text-white font-bold flex-shrink-0">
                                {{ commentaire.user.first_name|default:commentaire.user.username|slice:":1"|upper }}
                            </div>
                            <div class="flex-1">
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="font-semibold text-slate-900 text-sm">{{ commentaire.user.username }}</span>
                                    <span class="text-xs text-slate-500">{{ commentaire.created_at|date:"d/m/Y à H:i" }}</span>
                                </div>
                                <p class="text-slate-700 text-sm leading-relaxed">{{ commentaire.contenu }}</p>
                            </div>
                        </div>
                        {% empty %}
                        <div class="text-center py-8">
                            <svg class="w-12 h-12 text-slate-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                            </svg>
                            <p class="text-slate-500 text-sm">Soyez le premier à commenter cette vidéo !</p>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <!-- Section Latérale (1/3) -->
            <div class="space-y-6">
                <!-- Recherche mobile -->
                <div class="md:hidden">
                    <div class="relative">
                        <input type="text" id="searchInputMobile" placeholder="Rechercher une vidéo..." 
                               class="w-full px-4 py-3 pl-11 bg-white border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-900/20 focus:border-blue-900 transition-all">
                        <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                    </div>
                </div>

                <!-- Statut abonnement -->
                <div class="glass-panel rounded-2xl p-6">
                    <h3 class="font-bold text-slate-900 mb-4">Votre statut</h3>
                    {% if user_subscription_info %}
                        <div class="flex items-center gap-3 p-4 bg-green-50 border border-green-200 rounded-xl">
                            <div class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center text-white">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                </svg>
                            </div>
                            <div>
                                <p class="font-bold text-green-700 text-sm">Abonnement Premium Actif</p>
                                <p class="text-xs text-green-600">{{ temps_restant_detail }} restants</p>
                            </div>
                        </div>
                    {% else %}
                        <div class="text-center p-4">
                            <p class="text-slate-600 text-sm mb-3">Accédez à tout le contenu premium</p>
                            <a href="{% url 'dashboard' %}#abonnement" class="inline-block px-6 py-2.5 bg-blue-900 text-white text-sm font-bold rounded-xl hover:bg-blue-800 transition-all">
                                Voir les offres
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </main>

    <!-- Toast notification -->
    <div id="toast" class="fixed bottom-6 right-6 px-6 py-4 bg-slate-900 text-white rounded-xl shadow-2xl transform translate-y-20 opacity-0 transition-all duration-300 z-50">
        <span id="toastMessage"></span>
    </div>

    <script>
        // Initialisation de Plyr
        const player = new Plyr('#mainVideo', {
            controls: [
                'play-large',
                'play',
                'progress',
                'current-time',
                'mute',
                'volume',
                'settings',
                'pip',
                'airplay',
                'fullscreen'
            ],
            settings: ['speed', 'loop'],
            speed: { selected: 1, options: [0.5, 0.75, 1, 1.25, 1.5, 2] },
            keyboard: { focused: true, global: true },
            tooltips: { controls: true, seek: true },
            hideControls: false,
            resetOnEnd: false,
            invertTime: true,
            autoplay: false,
            loop: { active: false }
        });
        
        // Événements
        player.on('ready', function(event) {
            console.log('Plyr is ready', event);
        });
        
        player.on('error', function(event) {
            console.error('Plyr error:', event);
        });
        
        player.on('play', function() {
            console.log('Playing');
        });
        
        player.on('pause', function() {
            console.log('Paused');
        });

        // Accordéon pour la description
        let descriptionExpanded = false;
        
        function toggleDescription() {
            const summary = document.getElementById('descriptionSummary');
            const full = document.getElementById('fullDescription');
            const chevron = document.getElementById('chevronIcon');
            const expandText = document.getElementById('expandText');
            
            descriptionExpanded = !descriptionExpanded;
            
            if (descriptionExpanded) {
                summary.classList.add('hidden');
                full.classList.remove('hidden');
                chevron.classList.add('rotate-180');
            } else {
                summary.classList.remove('hidden');
                full.classList.add('hidden');
                chevron.classList.remove('rotate-180');
            }
        }
        
        // Gestion des likes sans rechargement
        let isLiked = {{ user_has_liked|yesno:"true,false" }};
        let likeCount = {{ video.likes_count|default:0 }};

        // Initialiser l'état du bouton like au chargement
        document.addEventListener('DOMContentLoaded', function() {
            const likeBtn = document.getElementById('likeBtn');
            const likeCountEl = document.getElementById('likeCount');
            if (isLiked) {
                likeBtn.classList.add('liked');
            }
        });

        function toggleLike() {
            const likeBtn = document.getElementById('likeBtn');
            const likeCountEl = document.getElementById('likeCount');
            
            isLiked = !isLiked;
            likeCount += isLiked ? 1 : -1;
            
            likeBtn.classList.toggle('liked', isLiked);
            likeCountEl.textContent = likeCount;
            
            // Envoyer la requête AJAX
            fetch("{% url 'like_video' video.id %}", {
                method: 'POST',
                headers: {
                    'X-CSRFToken': getCookie('csrftoken'),
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ liked: isLiked })
            })
            .then(response => {
                if (!response.ok) throw new Error('Erreur HTTP');
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    likeCountEl.textContent = data.like_count;
                } else {
                    // Rollback en cas d'erreur
                    rollbackLike();
                }
            })
            .catch(err => {
                console.error('Erreur like:', err);
                rollbackLike();
            });
        }

        function rollbackLike() {
            const likeBtn = document.getElementById('likeBtn');
            const likeCountEl = document.getElementById('likeCount');
            isLiked = !isLiked;
            likeCount += isLiked ? 1 : -1;
            likeBtn.classList.toggle('liked', isLiked);
            likeCountEl.textContent = likeCount;
            showToast('Erreur lors du like');
        }

        // Gestion des commentaires sans rechargement
        document.getElementById('commentForm').addEventListener('submit', function(e) {
            e.preventDefault();

            const input = document.getElementById('commentInput');
            const contenu = input.value;
            const submitBtn = this.querySelector('button[type="submit"]');

            if (!contenu || !contenu.trim()) return;
            
            // Désactiver le bouton pendant l'envoi
            submitBtn.disabled = true;
            submitBtn.textContent = 'Envoi...';
            
            fetch(window.location.href, {
                method: 'POST',
                headers: {
                    'X-CSRFToken': getCookie('csrftoken'),
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `contenu=${encodeURIComponent(contenu)}`
            })
            .then(response => {
                if (!response.ok) throw new Error('Erreur HTTP');
                return response.json();
            })
            .then(data => {
                if (data.success && data.commentaire) {
                    // Ajouter le commentaire à la liste
                    addComment(data.commentaire);
                    input.value = '';
                    showToast('Commentaire ajouté avec succès !');
                } else {
                    showToast('Erreur lors de l\'envoi du commentaire');
                }
            })
            .catch(err => {
                console.error('Erreur:', err);
                showToast('Erreur lors de l\'envoi du commentaire');
            })
            .finally(() => {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Envoyer';
            });
        });

        function addComment(commentData) {
            const commentList = document.getElementById('commentList');
            const commentCountEl = document.getElementById('commentCount');
            
            // Supprimer le message "aucun commentaire" s'il existe
            const emptyMsg = commentList.querySelector('.text-center');
            if (emptyMsg) emptyMsg.remove();
            
            const commentHTML = `
                <div class="flex gap-4 animate-fade-in comment-item">
                    <div class="w-10 h-10 bg-gradient-to-br from-amber-400 to-orange-500 rounded-full flex items-center justify-center text-white font-bold flex-shrink-0">
                        ${commentData.user_initial}
                    </div>
                    <div class="flex-1">
                        <div class="flex items-center gap-2 mb-1">
                            <span class="font-semibold text-slate-900 text-sm">${escapeHtml(commentData.user)}</span>
                            <span class="text-xs text-slate-500">${escapeHtml(commentData.created_at)}</span>
                        </div>
                        <p class="text-slate-700 text-sm leading-relaxed">${escapeHtml(commentData.contenu)}</p>
                    </div>
                </div>
            `;
            
            commentList.insertAdjacentHTML('beforeend', commentHTML);
            
            // Mettre à jour le compteur
            const count = parseInt(commentCountEl.textContent.replace(/\D/g, '')) || 0;
            commentCountEl.textContent = `(${count + 1})`;
        }

        // Partager la vidéo
        function shareVideo() {
            const url = window.location.href;
            navigator.clipboard.writeText(url).then(() => {
                showToast('Lien copié dans le presse-papier !');
            }).catch(() => {
                showToast('Erreur lors de la copie du lien');
            });
        }

        // Afficher un toast notification
        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toastMessage');
            toastMessage.textContent = message;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        // Helper: Get CSRF token
        function getCookie(name) {
            let cookieValue = null;
            if (document.cookie && document.cookie !== '') {
                const cookies = document.cookie.split(';');
                for (let i = 0; i < cookies.length; i++) {
                    const cookie = cookies[i].trim();
                    if (cookie.substring(0, name.length + 1) === (name + '=')) {
                        cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
                        break;
                    }
                }
            }
            return cookieValue;
        }

        // Helper: Escape HTML
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Recherche avec suggestions
        const searchInput = document.getElementById('searchInput');
        const searchInputMobile = document.getElementById('searchInputMobile');
        const searchSuggestions = document.getElementById('searchSuggestions');
        const suggestionsContent = document.getElementById('suggestionsContent');

        let debounceTimer;
        [searchInput, searchInputMobile].filter(Boolean).forEach(input => {
            input.addEventListener('input', function(e) {
                const query = e.target.value.trim();
                
                clearTimeout(debounceTimer);
                if (query.length >= 2) {
                    debounceTimer = setTimeout(() => {
                        showSearchSuggestions(query);
                    }, 150);
                } else {
                    searchSuggestions.classList.add('hidden');
                }
            });

            input.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const query = this.value.trim();
                    if (query) {
                        window.location.href = `{% url 'video' %}?q=${encodeURIComponent(query)}`;
                    }
                }
            });
        });

        function showSearchSuggestions(query) {
            fetch(`{% url 'api_search_videos' %}?q=${encodeURIComponent(query)}&limit=6`)
                .then(response => response.json())
                .then(data => {
                    const videos = data.videos || [];

                    if (videos.length === 0) {
                        searchSuggestions.classList.add('hidden');
                        return;
                    }

                    let html = '';

                    // En-tête
                    html += '<div class="p-3 border-b border-slate-100 bg-slate-50 rounded-t-xl"><p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Vidéos trouvées</p></div>';

                    // Vérifier si l'utilisateur a un abonnement
                    const hasSubscription = {{ user.profile.is_premium|yesno:"true,false" }};

                    // Suggestions de vidéos
                    html += videos.map(video => {
                        let clickAction = '';
                        let badgeClass = '';
                        let badgeText = '';
                        let lockIcon = '';
                        let opacityClass = '';
                        let warningText = '';
                        
                        if (video.is_free) {
                            // Vidéo gratuite - accès direct
                            clickAction = `href="${video.url}"`;
                            badgeClass = 'bg-green-600';
                            badgeText = 'Gratuit';
                        } else {
                            // Vidéo premium
                            if (hasSubscription) {
                                // Utilisateur premium - accès direct
                                clickAction = `href="${video.url}"`;
                                badgeClass = 'bg-amber-600';
                                badgeText = 'Premium';
                            } else {
                                // Utilisateur gratuit - rediriger vers abonnement
                                clickAction = `href="{% url 'dashboard' %}#abonnement" onclick="event.preventDefault(); window.location.href='{% url 'dashboard' %}#abonnement';"`
                                badgeClass = 'bg-red-600';
                                badgeText = '🔒 Premium';
                                lockIcon = '<svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>';
                                opacityClass = 'opacity-75';
                                warningText = '<p class="text-[9px] text-red-600 font-bold mt-1">⚠️ Abonnement requis</p>';
                            }
                        }
                        
                        return `
                            <a ${clickAction} class="flex gap-3 px-4 py-3 hover:bg-slate-50 transition-colors ${opacityClass}">
                                <div class="w-28 h-16 rounded-lg overflow-hidden flex-shrink-0 bg-slate-800 relative">
                                    ${video.miniature
                                        ? `<img src="${video.miniature}" alt="${video.titre}" class="w-full h-full object-cover">`
                                        : `<div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-blue-900 to-indigo-950">
                                            <svg class="w-6 h-6 text-white/40" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M8 5v14l11-7z"/>
                                            </svg>
                                        </div>`
                                    }
                                    <div class="absolute bottom-1 right-1">
                                        <span class="text-[8px] px-1 py-0.5 ${badgeClass} text-white rounded font-bold flex items-center">
                                            ${lockIcon}${badgeText}
                                        </span>
                                    </div>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="font-semibold text-slate-900 text-sm line-clamp-2">${highlightMatch(video.titre, query)}</p>
                                    <p class="text-xs text-slate-500 mt-0.5">${video.categorie || 'Non catégorisé'}</p>
                                    <p class="text-xs text-slate-400 mt-1">${video.date_pub}</p>
                                    ${warningText}
                                </div>
                            </a>
                        `;
                    }).join('');

                    suggestionsContent.innerHTML = html;
                    searchSuggestions.classList.remove('hidden');
                })
                .catch(err => {
                    console.error('Erreur recherche:', err);
                    searchSuggestions.classList.add('hidden');
                });
        }

        function highlightMatch(text, query) {
            const regex = new RegExp(`(${query})`, 'gi');
            return text.replace(regex, '<mark class="bg-amber-200 text-slate-900 px-0.5 rounded">$1</mark>');
        }

        // Cacher les suggestions au clic en dehors
        document.addEventListener('click', function(e) {
            if (searchInput && !searchInput.contains(e.target) && 
                searchSuggestions && !searchSuggestions.contains(e.target)) {
                searchSuggestions.classList.add('hidden');
            }
        });
    </script>

</body>
</html>
